<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The hardened runtime blocks Apple events, which osascript and the AppleScript tools send, without this. -->
  <key>com.apple.security.automation.apple-events</key><true/>
  <!-- EventKit's calendar data under the hardened runtime. It covers both events and reminders, which come from the same event store. -->
  <key>com.apple.security.personal-information.calendars</key><true/>
</dict>
</plist>
