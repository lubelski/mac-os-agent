<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The script runner gets the App Sandbox and nothing else: no files beyond its own
	     container, no network, and no Apple events. A script reaches the Mac only through the
	     tool calls the app runs for it. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
